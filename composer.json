{
  "name": "comphp/database-mssql",
  "type": "library",
  "description": "Database Driver for CommonPHP that builds queries for and connects to Microsoft SQL Server",
  "license": "MIT",
  "version": "0.3",
  "autoload": {
    "psr-4": {
      "CommonPHP\\Drivers\\Database\\MSSQL\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "CommonPHP\\Drivers\\Database\\MSSQL\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": "^8.5",
    "comphp/config": "^0.3",
    "comphp/database": "^0.3"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.1",
    "friendsofphp/php-cs-fixer": "^3.95"
  }
}