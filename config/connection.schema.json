{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://commonphp.org/schemas/database/mssql-connection.schema.json",
  "title": "Microsoft SQL Server Connection Configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "username": {
      "type": "string",
      "default": "sa"
    },
    "password": {
      "type": "string",
      "default": ""
    },
    "server": {
      "type": "string",
      "minLength": 1,
      "default": "127.0.0.1"
    },
    "Server": {
      "type": "string"
    },
    "host": {
      "type": "string",
      "minLength": 1
    },
    "Host": {
      "type": "string",
      "minLength": 1
    },
    "database": {
      "type": "string",
      "minLength": 1
    },
    "Database": {
      "type": "string",
      "minLength": 1
    },
    "dbname": {
      "type": "string",
      "minLength": 1
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535,
      "default": 1433
    },
    "Port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "app": {
      "type": "string",
      "minLength": 1
    },
    "App": {
      "type": "string",
      "minLength": 1
    },
    "applicationName": {
      "type": "string",
      "minLength": 1
    },
    "ApplicationName": {
      "type": "string",
      "minLength": 1
    },
    "trustServerCertificate": {
      "type": "boolean",
      "default": false
    },
    "TrustServerCertificate": {
      "type": "boolean",
      "default": false
    },
    "trustServerCertificates": {
      "type": "boolean",
      "default": false
    },
    "TrustServerCertificates": {
      "type": "boolean",
      "default": false
    },
    "encrypt": {
      "type": "boolean",
      "default": false
    },
    "Encrypt": {
      "type": "boolean",
      "default": false
    },
    "loginTimeout": {
      "type": "integer",
      "minimum": 1
    },
    "LoginTimeout": {
      "type": "integer",
      "minimum": 1
    },
    "timeout": {
      "type": "integer",
      "minimum": 1
    },
    "persistent": {
      "type": "boolean",
      "default": false
    },
    "connectionPooling": {
      "type": "boolean",
      "default": true
    },
    "ConnectionPooling": {
      "type": "boolean",
      "default": true
    },
    "multipleActiveResultSets": {
      "type": "boolean",
      "default": true
    },
    "MultipleActiveResultSets": {
      "type": "boolean",
      "default": true
    },
    "charset": {
      "type": "string",
      "minLength": 1
    },
    "CharacterSet": {
      "type": "string",
      "minLength": 1
    },
    "attributes": {
      "type": "object"
    },
    "driverOptions": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "anyOf": [
        {
          "required": [
            "server"
          ]
        },
        {
          "required": [
            "Server"
          ]
        },
        {
          "required": [
            "host"
          ]
        },
        {
          "required": [
            "Host"
          ]
        }
      ]
    },
    {
      "anyOf": [
        {
          "required": [
            "database"
          ]
        },
        {
          "required": [
            "Database"
          ]
        },
        {
          "required": [
            "dbname"
          ]
        }
      ]
    }
  ],
  "required": [
    "username",
    "password"
  ]
}
